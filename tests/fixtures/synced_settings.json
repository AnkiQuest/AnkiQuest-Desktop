{
  "_about": "Player preferences that follow the account to every device through GET/PUT /api/settings/{user}. The server reads `keys` from this file (src/synced_settings.rs) and tests `server_merge`; both clients map their own preference names with `desktop` and `android` and test `client_merge`. A client applies only the keys it has; null means that client has no such setting. Keys are never removed or retyped.",
  "switch": {
    "title": "Sync settings",
    "summary": "Keep AnkiQuest settings the same on all your devices. This switch applies only to this device.",
    "default": true,
    "desktop": "sync_settings",
    "android": "ankiquestSyncSettings"
  },
  "keys": [
    {
      "key": "notify_rank",
      "type": "bool",
      "default": true,
      "desktop": "notify_rank",
      "android": "ankiquestNotifyRank"
    },
    {
      "key": "streak_warning_hours",
      "type": "int",
      "min": 0,
      "max": 12,
      "default": 2,
      "desktop": "streak_hours",
      "android": "ankiquestStreakReminderHours"
    },
    {
      "key": "system_notifications",
      "type": "bool",
      "default": false,
      "desktop": "system_notifications",
      "android": null
    },
    {
      "key": "session_summary",
      "type": "bool",
      "default": true,
      "desktop": "session_summary",
      "android": "ankiquestSessionSummary"
    },
    {
      "key": "goal_celebrations",
      "type": "bool",
      "default": true,
      "desktop": "goal_celebrations",
      "android": "ankiquestStreakCue"
    },
    {
      "key": "deck_status",
      "type": "bool",
      "default": true,
      "desktop": "deck_status",
      "android": null
    },
    {
      "key": "review_heatmap",
      "type": "bool",
      "default": true,
      "desktop": "review_heatmap",
      "android": null
    },
    {
      "key": "mood_icon",
      "type": "bool",
      "default": true,
      "desktop": null,
      "android": "ankiquestMoodIcon"
    },
    {
      "key": "open_today",
      "type": "bool",
      "default": false,
      "desktop": null,
      "android": "ankiquestOpenToday"
    },
    {
      "key": "ask_to_share_decks",
      "type": "bool",
      "default": true,
      "desktop": null,
      "android": "ankiquestAskToShareDecks"
    }
  ],
  "server_merge": [
    {
      "name": "a first value is stored",
      "now_ms": 1793183400000,
      "stored": {},
      "incoming": {
        "notify_rank": {"value": false, "updated_at": 1793183000000}
      },
      "expected": {
        "notify_rank": {"value": false, "updated_at": 1793183000000}
      },
      "ignored": []
    },
    {
      "name": "a newer change replaces the stored value",
      "now_ms": 1793183400000,
      "stored": {
        "streak_warning_hours": {"value": 2, "updated_at": 1793180000000}
      },
      "incoming": {
        "streak_warning_hours": {"value": 5, "updated_at": 1793183000000}
      },
      "expected": {
        "streak_warning_hours": {"value": 5, "updated_at": 1793183000000}
      },
      "ignored": []
    },
    {
      "name": "an older or equally old change is dropped",
      "now_ms": 1793183400000,
      "stored": {
        "notify_rank": {"value": true, "updated_at": 1793183000000},
        "session_summary": {"value": true, "updated_at": 1793183000000}
      },
      "incoming": {
        "notify_rank": {"value": false, "updated_at": 1793182000000},
        "session_summary": {"value": false, "updated_at": 1793183000000}
      },
      "expected": {
        "notify_rank": {"value": true, "updated_at": 1793183000000},
        "session_summary": {"value": true, "updated_at": 1793183000000}
      },
      "ignored": []
    },
    {
      "name": "keys are merged one by one, so two devices changing different settings keep both",
      "now_ms": 1793183400000,
      "stored": {
        "notify_rank": {"value": false, "updated_at": 1793183000000},
        "deck_status": {"value": true, "updated_at": 1793170000000}
      },
      "incoming": {
        "notify_rank": {"value": true, "updated_at": 1793170000000},
        "deck_status": {"value": false, "updated_at": 1793182000000}
      },
      "expected": {
        "notify_rank": {"value": false, "updated_at": 1793183000000},
        "deck_status": {"value": false, "updated_at": 1793182000000}
      },
      "ignored": []
    },
    {
      "name": "a change from the future counts as made now",
      "now_ms": 1793183400000,
      "stored": {},
      "incoming": {
        "open_today": {"value": true, "updated_at": 1893183400000}
      },
      "expected": {
        "open_today": {"value": true, "updated_at": 1793183400000}
      },
      "ignored": []
    },
    {
      "name": "unknown keys are ignored and named",
      "now_ms": 1793183400000,
      "stored": {},
      "incoming": {
        "mood_icon": {"value": false, "updated_at": 1793183000000},
        "future_setting": {"value": "anything", "updated_at": 1793183000000}
      },
      "expected": {
        "mood_icon": {"value": false, "updated_at": 1793183000000}
      },
      "ignored": ["future_setting"]
    },
    {
      "name": "a value of the wrong type refuses the whole change",
      "now_ms": 1793183400000,
      "stored": {},
      "incoming": {
        "notify_rank": {"value": false, "updated_at": 1793183000000},
        "session_summary": {"value": "no", "updated_at": 1793183000000}
      },
      "refused": true
    },
    {
      "name": "a number outside its range refuses the whole change",
      "now_ms": 1793183400000,
      "stored": {},
      "incoming": {
        "streak_warning_hours": {"value": 13, "updated_at": 1793183000000}
      },
      "refused": true
    },
    {
      "name": "a fractional number refuses the whole change",
      "now_ms": 1793183400000,
      "stored": {},
      "incoming": {
        "streak_warning_hours": {"value": 2.5, "updated_at": 1793183000000}
      },
      "refused": true
    },
    {
      "name": "a negative time refuses the whole change",
      "now_ms": 1793183400000,
      "stored": {},
      "incoming": {
        "notify_rank": {"value": false, "updated_at": -1}
      },
      "refused": true
    }
  ],
  "client_merge": [
    {
      "name": "nothing anywhere: nothing to do",
      "key": "notify_rank",
      "local": {"value": true, "changed_at": 0},
      "remote": null,
      "expected": {"value": true, "changed_at": 0, "push": null}
    },
    {
      "name": "a choice made before sync existed is offered as the oldest possible change",
      "key": "notify_rank",
      "local": {"value": false, "changed_at": 0},
      "remote": null,
      "expected": {"value": false, "changed_at": 0, "push": {"value": false, "updated_at": 0}}
    },
    {
      "name": "a local change the server lacks is sent",
      "key": "streak_warning_hours",
      "local": {"value": 2, "changed_at": 1793183000000},
      "remote": null,
      "expected": {"value": 2, "changed_at": 1793183000000, "push": {"value": 2, "updated_at": 1793183000000}}
    },
    {
      "name": "a newer remote value is applied",
      "key": "notify_rank",
      "local": {"value": true, "changed_at": 1793180000000},
      "remote": {"value": false, "updated_at": 1793183000000},
      "expected": {"value": false, "changed_at": 1793183000000, "push": null}
    },
    {
      "name": "a remote value replaces a choice made before sync existed",
      "key": "streak_warning_hours",
      "local": {"value": 4, "changed_at": 0},
      "remote": {"value": 6, "updated_at": 0},
      "expected": {"value": 6, "changed_at": 0, "push": null}
    },
    {
      "name": "on a tie the server's value wins, as the server keeps it",
      "key": "notify_rank",
      "local": {"value": true, "changed_at": 1793183000000},
      "remote": {"value": false, "updated_at": 1793183000000},
      "expected": {"value": false, "changed_at": 1793183000000, "push": null}
    },
    {
      "name": "a newer local change is sent",
      "key": "notify_rank",
      "local": {"value": false, "changed_at": 1793183000000},
      "remote": {"value": true, "updated_at": 1793180000000},
      "expected": {"value": false, "changed_at": 1793183000000, "push": {"value": false, "updated_at": 1793183000000}}
    },
    {
      "name": "a remote value the client cannot use is ignored and the local one stays",
      "key": "streak_warning_hours",
      "local": {"value": 3, "changed_at": 1793180000000},
      "remote": {"value": 99, "updated_at": 1793183000000},
      "expected": {"value": 3, "changed_at": 1793180000000, "push": null}
    }
  ]
}
